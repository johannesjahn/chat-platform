{
  "name": "chat-platform-web",
  "version": "0.39.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build && vite build --config vite.pwa.config.ts",
    "preview": "vite preview --port 3001",
    "analyze": "vite build --sourcemap && bun scripts/analyze-bundle.ts",
    "gen:routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:e2e": "playwright test",
    "gen:types": "bun run ../scripts/gen-openapi.ts && openapi-typescript ../openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/query-sync-storage-persister": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "blurhash": "2.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.61.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vite-tsconfig-paths": "6.1.1"
  },
  "overrides": {
    "fast-uri": "4.2.3",
    "js-yaml": "4.3.2",
    "brace-expansion": "5.0.12",
    "nanoid": "6.0.2"
  }
}
