# Cache-Control for the Cloudflare Workers static-assets deploy (issue #606).
# Vite copies this file into dist/client; see "Caching" in web/README.md for
# what to mirror on any other static host.
#
# Rules match the *request* path and every matching rule applies, in file
# order. A header set by two rules would be comma-joined, so each override
# below first removes the catch-all's value with `! Cache-Control`.

# The app shell and everything not covered below: index.html (including
# when it's served as the SPA fallback for a deep link like /chats/123),
# sw.js and manifest.webmanifest. Revalidate on every use so a deploy is
# picked up promptly; the PWA's auto-update depends on a fresh sw.js.
/*
  Cache-Control: no-cache

# Content-hashed build output: a changed file gets a new name, so the old
# one can be cached forever.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The Workbox runtime sw.js imports, also content-hashed.
/workbox-*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Icons keep stable names, so only cache them briefly.
/favicon*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/logo.*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Crawl rules: not content-hashed, but rarely change.
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600
