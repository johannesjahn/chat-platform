{
  "name": "chat-platform",
  "version": "0.25.0",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test ./src --parallel --timeout=15000",
    "test:coverage": "bun test ./src --parallel --timeout=15000 --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:openapi": "bun run scripts/gen-openapi.ts",
    "sync:chart-version": "bun run scripts/sync-chart-version.ts",
    "bump": "bun run scripts/bump.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:backfill-avatars": "bun run scripts/backfill-avatars.ts",
    "loadtest:http": "k6 run scripts/loadtest/http-crud.js",
    "loadtest:ws": "k6 run scripts/loadtest/ws-fanout.js"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "@electric-sql/pglite": "0.5.6",
    "blurhash": "2.0.5",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
