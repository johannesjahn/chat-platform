{
  "name": "chat-platform",
  "version": "0.42.1",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test ./src --parallel --timeout=15000",
    "test:coverage": "bun test ./src --parallel --timeout=15000 --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:openapi": "bun run scripts/gen-openapi.ts",
    "sync:chart-version": "bun run scripts/sync-chart-version.ts",
    "bump": "bun run scripts/bump.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "loadtest:http": "k6 run scripts/loadtest/http-crud.js",
    "loadtest:ws": "k6 run scripts/loadtest/ws-fanout.js"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.7",
    "@electric-sql/pglite": "0.6.1",
    "blurhash": "2.0.5",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.74.0"
  },
  "overrides": {
    "brace-expansion": "5.1.0"
  }
}
